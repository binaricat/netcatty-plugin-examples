{
  "manifestVersion": 1,
  "id": "com.netcatty.market-smoke",
  "name": "market-smoke",
  "displayName": {
    "en": "Marketplace Acceptance Example",
    "zh-CN": "市场验收样例"
  },
  "description": "Visible test example for install and update acceptance. No external data access.",
  "version": "0.1.1",
  "publisher": "netcatty",
  "license": "MIT",
  "engines": {
    "netcatty": "=0.0.0",
    "api": "=0.1.0-internal.1"
  },
  "main": {
    "browser": "index.js"
  },
  "activationEvents": [
    "onCommand:com.netcatty.market-smoke.version",
    "onView:com.netcatty.market-smoke.panel"
  ],
  "permissions": {
    "required": [
      "commands",
      "menus",
      "views"
    ],
    "optional": []
  },
  "contributes": {
    "commands": [
      {
        "id": "com.netcatty.market-smoke.version",
        "title": {
          "en": "Acceptance Example: Read Version"
        }
      }
    ],
    "menus": [
      {
        "command": "com.netcatty.market-smoke.version",
        "location": "commandPalette",
        "group": "examples"
      }
    ],
    "views": [
      {
        "id": "com.netcatty.market-smoke.panel",
        "title": {
          "en": "Marketplace Acceptance Example"
        },
        "location": "modal",
        "entry": "panel.html"
      }
    ]
  }
}
